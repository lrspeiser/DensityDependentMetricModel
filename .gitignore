# -----------------------------------------------------------------------------
# --- Project-Specific Ignores for DensityDependentMetricModel ---
# -----------------------------------------------------------------------------

# Ignore all data, cache, and results directories by pattern
chains_*/
chains_emcee*/
chains_dynesty*/

# Ignore most large data files globally
*.h5
*.npy
*.pkl.gz
*.sav
*.fits
*.png
*.txt
!progress_plots.png
# Keep figures used in the paper and README
!images/*.png
!docs/figures/*.png

# -------------------------------------------------------------------
# 🚨 FIXED: Ignore CSV and Parquet globally, except for gaia_sky_slices/
# -------------------------------------------------------------------
*.csv
*.parquet
!gaia_sky_slices/*.csv
!gaia_sky_slices/*.parquet

# -------------------------------------------------------------------
# 🆕 Runtime and Monitoring Files (Machine-Specific)
# -------------------------------------------------------------------
# Resource usage monitoring (large, machine-specific)
resource_usage.json
hardware_info.json
run_stats.json
run_stats_history.json

# Dynesty checkpoints and intermediate files (can be regenerated)
dynesty_checkpoint*.npz
dynesty_checkpoint*.pkl
*.npz
!tier1_best_fit.npz

# Periodic analysis outputs (can be regenerated)
periodic_analyses/

# CLI command logs (machine-specific)
cli_command.txt

# Exclude local run artifacts and large files
runs/
*.npz
*.pkl

# Allow tracked plots and summaries for SPARC gate sweeps (PNG via Git LFS)
!sparc_rargate_gold_plots/**/*.png
!sparc_rargate_gold_plots/**/*.csv
